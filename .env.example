# Public logo source used by the marketplace and API.
NEXT_PUBLIC_LOGO_STORAGE_BASE_URL=https://logomarketplace617db5.blob.core.windows.net/logos

# Optional public API origin used in generated documentation links.
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Azure Table Storage for hashed API keys and bounded usage counters.
AZURE_STORAGE_ACCOUNT_NAME=logomarketplace617db5
AZURE_TABLE_ENDPOINT=https://logomarketplace617db5.table.core.windows.net
AZURE_API_KEYS_TABLE=LogoApiKeys
AZURE_API_USAGE_TABLE=LogoApiUsage

# Local-only alternative to DefaultAzureCredential. Never commit its value.
# AZURE_STORAGE_CONNECTION_STRING=
