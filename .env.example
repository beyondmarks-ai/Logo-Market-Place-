# Administrator password and signing secrets are stored in Azure Key Vault.
# OTP delivery is restricted in server code to approved academy contacts.
AZURE_KEY_VAULT_URL=https://your-key-vault.vault.azure.net/
# Set only in Azure for a user-assigned managed identity. Local development uses Azure CLI.
AZURE_CLIENT_ID=your-managed-identity-client-id

# Azure Communication Services (keyless Azure CLI / managed identity authentication)
AZURE_COMMUNICATION_ENDPOINT=https://bm-academy-otp.asiapacific.communication.azure.com
AZURE_EMAIL_SENDER=DoNotReply@6b1c7d53-09ac-4cf4-8311-3e0d04317e2d.azurecomm.net
AZURE_SMS_FROM=+1XXXXXXXXXX

# Key Vault secret names used by the application:
# admin-password, otp-signing-secret, admin-session-secret

# Azure Foundry avatar generation (gpt-image-2)
AZURE_FOUNDRY_IMAGE_ENDPOINT=https://your-ai-services-resource.cognitiveservices.azure.com
AZURE_FOUNDRY_IMAGE_DEPLOYMENT=gpt-image-2
